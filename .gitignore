# ==============================================================================
# R Language
# ==============================================================================

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/
*.Rproj

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# ==============================================================================
# Project-Specific: Scientific Collaboration Network Analysis
# ==============================================================================

# Raw data files (too large for Git, can be re-downloaded)
data/raw/*.txt
data/raw/*.gz
data/raw/*.zip

# Processed data (can be regenerated from scripts)
data/processed/*.rds
data/processed/*.csv

# Output files
output/figures/*.png
output/figures/*.pdf
output/figures/*.svg
output/tables/*.csv
output/tables/*.xlsx
output/reports/*.html
output/reports/*.pdf

# Keep directory structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep
!output/figures/.gitkeep
!output/tables/.gitkeep
!output/reports/.gitkeep

# ==============================================================================
# System files
# ==============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==============================================================================
# Temporary files
# ==============================================================================

*.tmp
*.log
*.swp
*.swo
*~

# ==============================================================================
# IDEs and Editors
# ==============================================================================

# Visual Studio Code
.vscode/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
